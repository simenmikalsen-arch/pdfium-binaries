diff --git a/fpdfsdk/fpdf_annot_embeddertest.cpp b/fpdfsdk/fpdf_annot_embeddertest.cpp
index 470b1f1..059285d 100644
--- a/fpdfsdk/fpdf_annot_embeddertest.cpp
+++ b/fpdfsdk/fpdf_annot_embeddertest.cpp
@@ -445,6 +445,28 @@ TEST_F(FPDFAnnotEmbedderTest, RenderAnnotWithOnlyRolloverAP) {
   CompareBitmap(bitmap.get(), "fpdf_annot_render_annot_with_only_rollover_ap");
 }
 
+TEST_F(FPDFAnnotEmbedderTest, RenderAddsNoPopupObjectsToDocument) {
+  // One highlight annotation with (long) /Contents: every render call with
+  // FPDF_ANNOT builds a CPDF_AnnotList, which creates a popup for it.
+  ASSERT_TRUE(OpenDocument("annotation_highlight_long_content.pdf"));
+  ScopedPage page = LoadScopedPage(0);
+  ASSERT_TRUE(page);
+  // The first render may legitimately add the markup's own appearance.
+  RenderLoadedPageWithFlags(page.get(), FPDF_ANNOT);
+  // An incremental save writes every object the document holds that is new
+  // or loaded, so its size shows whether later renders create objects.
+  ASSERT_TRUE(FPDF_SaveAsCopy(document(), this, FPDF_INCREMENTAL));
+  const size_t size = GetString().size();
+  ClearString();
+
+  for (int i = 0; i < 5; ++i) {
+    RenderLoadedPageWithFlags(page.get(), FPDF_ANNOT);
+  }
+
+  ASSERT_TRUE(FPDF_SaveAsCopy(document(), this, FPDF_INCREMENTAL));
+  EXPECT_EQ(size, GetString().size());
+}
