diff --git a/core/fpdfdoc/cpdf_annot.cpp b/core/fpdfdoc/cpdf_annot.cpp
index 9178264..13a9680 100644
--- a/core/fpdfdoc/cpdf_annot.cpp
+++ b/core/fpdfdoc/cpdf_annot.cpp
@@ -134,7 +134,16 @@ CPDF_Annot::CPDF_Annot(RetainPtr<CPDF_Dictionary> dict, CPDF_Document* document)
       is_text_markup_annotation_(IsTextMarkupAnnotation(subtype_)),
       has_generated_ap_(
           annot_dict_->GetBooleanFor(kPDFiumKey_HasGeneratedAP, false)) {
-  GenerateAPIfNeeded();
+  // A Popup annotation is only ever the one CPDF_AnnotList creates for a
+  // markup annotation with /Contents (popups from the file are skipped). It is
+  // drawn only while it is open (ShouldDrawAnnotation()), and DrawAppearance()
+  // / DrawInContext() generate its appearance on demand. Generating it here
+  // added a new appearance stream and a new font dictionary to the document
+  // for every such markup on every CPDF_AnnotList construction (every render
+  // call with FPDF_ANNOT), and a full save wrote all of them.
+  if (subtype_ != Subtype::POPUP) {
+    GenerateAPIfNeeded();
+  }
 }
 
 CPDF_Annot::~CPDF_Annot() {
diff --git a/core/fpdfdoc/cpdf_annotlist_unittest.cpp b/core/fpdfdoc/cpdf_annotlist_unittest.cpp
index a59f959..c64bb05 100644
--- a/core/fpdfdoc/cpdf_annotlist_unittest.cpp
+++ b/core/fpdfdoc/cpdf_annotlist_unittest.cpp
@@ -115,6 +115,27 @@ TEST_F(CPDFAnnotListTest, CreatePopupAnnotFromEmptyUnicode) {
   EXPECT_EQ(1u, list.Count());
 }
 
+TEST_F(CPDFAnnotListTest, CreatePopupAnnotAddsNoObjectsToDocument) {
+  AddTextAnnotation("Hello");
+
+  {
+    // The first list makes the annotation indirect and generates its own
+    // appearance - both are kept in the document.
+    CPDF_AnnotList list(page_);
+    ASSERT_EQ(2u, list.Count());
+  }
+  const uint32_t last_obj_num = document_->GetLastObjNum();
+  for (int i = 0; i < 3; ++i) {
+    CPDF_AnnotList list(page_);
+    ASSERT_EQ(2u, list.Count());
+    const CPDF_Annot* popup = list.GetAt(1);
+    EXPECT_EQ(CPDF_Annot::Subtype::POPUP, popup->GetSubtype());
+    // The popup is closed, so it has no appearance yet.
+    EXPECT_FALSE(popup->GetAnnotDict()->KeyExist(pdfium::annotation::kAP));
+  }
+  EXPECT_EQ(last_obj_num, document_->GetLastObjNum());
+}
