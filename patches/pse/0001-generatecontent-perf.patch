+TEST_F(CPDFPageContentGeneratorTest, KeepXObjectNames) {
+  auto doc = std::make_unique<CPDF_TestDocument>();
+  doc->CreateNewDoc();
+  RetainPtr<CPDF_Stream> form0 = AddFormXObject(doc.get());
+  RetainPtr<CPDF_Stream> form1 = AddFormXObject(doc.get());
+
+  RetainPtr<CPDF_Dictionary> page_dict = doc->CreateNewPage(0);
+  RetainPtr<CPDF_Dictionary> xobjects =
+      page_dict->SetNewFor<CPDF_Dictionary>("Resources")
+          ->SetNewFor<CPDF_Dictionary>("XObject");
+  xobjects->SetNewFor<CPDF_Reference>("Fm0", doc.get(), form0->GetObjNum());
+  xobjects->SetNewFor<CPDF_Reference>("Fm1", doc.get(), form1->GetObjNum());
+  RetainPtr<CPDF_Stream> contents =
+      AddStream(doc.get(),
+                "q /Fm0 Do Q q 1 0 0 1 20 0 cm /Fm1 Do Q "
+                "q 1 0 0 1 40 0 cm /Fm0 Do Q",
+                pdfium::MakeRetain<CPDF_Dictionary>());
+  page_dict->SetNewFor<CPDF_Reference>("Contents", doc.get(),
+                                       contents->GetObjNum());
+
+  auto page = pdfium::MakeRetain<CPDF_Page>(doc.get(), page_dict);
+  page->ParseContent();
+  ASSERT_EQ(3u, page->GetPageObjectCount());
+
+  // Regenerate the content more than once. Each regeneration used to give all
+  // the XObjects new names.
+  for (int i = 0; i < 3; ++i) {
+    for (size_t j = 0; j < page->GetPageObjectCount(); ++j) {
+      page->GetPageObjectByIndex(j)->SetDirty(true);
+    }
+    CPDF_PageContentGenerator generator(page.Get());
+    generator.GenerateContent();
+
+    EXPECT_EQ("Fm0", page->GetPageObjectByIndex(0)->GetResourceName());
+    EXPECT_EQ("Fm1", page->GetPageObjectByIndex(1)->GetResourceName());
+    EXPECT_EQ("Fm0", page->GetPageObjectByIndex(2)->GetResourceName());
+    RetainPtr<const CPDF_Dictionary> xobjects_after =
+        page->GetResources()->GetDictFor("XObject");
+    ASSERT_TRUE(xobjects_after);
+    EXPECT_EQ((std::vector<ByteString>{"Fm0", "Fm1"}),
+              xobjects_after->GetKeys());
+    const auto& removed_resources = page->all_removed_resources_map();
+    auto removed_it = removed_resources.find(ByteStringView("XObject"));
+    EXPECT_TRUE(removed_it == removed_resources.end() ||
+                removed_it->second.empty());
+
+    const ByteString content = GetStreamData(contents);
+    EXPECT_TRUE(content.Contains("/Fm0 Do"));
+    EXPECT_TRUE(content.Contains("/Fm1 Do"));
+    EXPECT_FALSE(content.Contains("/FXX"));
+  }
+}
