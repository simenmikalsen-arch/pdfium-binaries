+TEST_F(CPDFPageContentGeneratorTest, RenameXObjectWhenNameRefersToOtherObject) {
+  auto doc = std::make_unique<CPDF_TestDocument>();
+  doc->CreateNewDoc();
+  RetainPtr<CPDF_Stream> form0 = AddFormXObject(doc.get());
+  RetainPtr<CPDF_Stream> form1 = AddFormXObject(doc.get());
+
+  RetainPtr<CPDF_Dictionary> page_dict = doc->CreateNewPage(0);
+  RetainPtr<CPDF_Dictionary> xobjects =
+      page_dict->SetNewFor<CPDF_Dictionary>("Resources")
+          ->SetNewFor<CPDF_Dictionary>("XObject");
+  xobjects->SetNewFor<CPDF_Reference>("Fm0", doc.get(), form0->GetObjNum());
+  RetainPtr<CPDF_Stream> contents = AddStream(
+      doc.get(), "q /Fm0 Do Q", pdfium::MakeRetain<CPDF_Dictionary>());
+  page_dict->SetNewFor<CPDF_Reference>("Contents", doc.get(),
+                                       contents->GetObjNum());
+
+  auto page = pdfium::MakeRetain<CPDF_Page>(doc.get(), page_dict);
+  page->ParseContent();
+  ASSERT_EQ(1u, page->GetPageObjectCount());
+
+  // After parsing, "Fm0" no longer refers to the form the page object draws.
+  xobjects->SetNewFor<CPDF_Reference>("Fm0", doc.get(), form1->GetObjNum());
+  page->GetPageObjectByIndex(0)->SetDirty(true);
+  CPDF_PageContentGenerator generator(page.Get());
+  generator.GenerateContent();
+
+  EXPECT_EQ("FXX1", page->GetPageObjectByIndex(0)->GetResourceName());
+  RetainPtr<const CPDF_Dictionary> xobjects_after =
+      page->GetResources()->GetDictFor("XObject");
+  ASSERT_TRUE(xobjects_after);
+  EXPECT_EQ((std::vector<ByteString>{"FXX1"}), xobjects_after->GetKeys());
+  RetainPtr<const CPDF_Reference> ref =
+      ToReference(xobjects_after->GetObjectFor("FXX1"));
+  ASSERT_TRUE(ref);
+  EXPECT_EQ(form0->GetObjNum(), ref->GetRefObjNum());
+
+  const ByteString content = GetStreamData(contents);
+  EXPECT_TRUE(content.Contains("/FXX1 Do"));
+  EXPECT_FALSE(content.Contains("/Fm0"));
+}
