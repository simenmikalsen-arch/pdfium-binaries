+TEST_F(CPDFPageContentGeneratorTest, NewXObjectNamesSkipTakenNames) {
+  auto doc = std::make_unique<CPDF_TestDocument>();
+  doc->CreateNewDoc();
+  RetainPtr<CPDF_Stream> form0 = AddFormXObject(doc.get());
+
+  RetainPtr<CPDF_Dictionary> page_dict = doc->CreateNewPage(0);
+  RetainPtr<CPDF_Dictionary> xobjects =
+      page_dict->SetNewFor<CPDF_Dictionary>("Resources")
+          ->SetNewFor<CPDF_Dictionary>("XObject");
+  xobjects->SetNewFor<CPDF_Reference>("FXX2", doc.get(), form0->GetObjNum());
+  RetainPtr<CPDF_Stream> contents = AddStream(
+      doc.get(), "q /FXX2 Do Q", pdfium::MakeRetain<CPDF_Dictionary>());
+  page_dict->SetNewFor<CPDF_Reference>("Contents", doc.get(),
+                                       contents->GetObjNum());
+
+  auto page = pdfium::MakeRetain<CPDF_Page>(doc.get(), page_dict);
+  page->ParseContent();
+  ASSERT_EQ(1u, page->GetPageObjectCount());
+
+  // Pretend "FXX4" got removed from the resources earlier. It may get restored,
+  // so new names must not use it either.
+  page->all_removed_resources_map()["XObject"]["FXX4"] =
+      pdfium::MakeRetain<CPDF_Reference>(doc.get(), form0->GetObjNum());
+
+  std::vector<RetainPtr<CPDF_Stream>> new_forms;
+  for (int i = 0; i < 3; ++i) {
+    new_forms.push_back(AddFormXObject(doc.get()));
+    auto form_obj = std::make_unique<CPDF_FormObject>(
+        CPDF_PageObject::kNoContentStream,
+        std::make_unique<CPDF_Form>(doc.get(), nullptr, new_forms.back()),
+        CFX_Matrix());
+    form_obj->SetDirty(true);
+    page->AppendPageObject(std::move(form_obj));
+  }
+
+  CPDF_PageContentGenerator generator(page.Get());
+  generator.GenerateContent();
+
+  // The new names are the lowest free ones, in page object order.
+  ASSERT_EQ(4u, page->GetPageObjectCount());
+  EXPECT_EQ("FXX2", page->GetPageObjectByIndex(0)->GetResourceName());
+  EXPECT_EQ("FXX1", page->GetPageObjectByIndex(1)->GetResourceName());
+  EXPECT_EQ("FXX3", page->GetPageObjectByIndex(2)->GetResourceName());
+  EXPECT_EQ("FXX5", page->GetPageObjectByIndex(3)->GetResourceName());
+
+  RetainPtr<const CPDF_Dictionary> xobjects_after =
+      page->GetResources()->GetDictFor("XObject");
+  ASSERT_TRUE(xobjects_after);
+  EXPECT_EQ((std::vector<ByteString>{"FXX1", "FXX2", "FXX3", "FXX5"}),
+            xobjects_after->GetKeys());
+  const std::vector<ByteString> new_names = {"FXX1", "FXX3", "FXX5"};
+  for (size_t i = 0; i < new_names.size(); ++i) {
+    RetainPtr<const CPDF_Reference> ref =
+        ToReference(xobjects_after->GetObjectFor(new_names[i].AsStringView()));
+    ASSERT_TRUE(ref);
+    EXPECT_EQ(new_forms[i]->GetObjNum(), ref->GetRefObjNum());
+  }
+  EXPECT_TRUE(page->all_removed_resources_map()["XObject"].contains("FXX4"));
+  EXPECT_FALSE(xobjects_after->KeyExist("FXX4"));
+}
