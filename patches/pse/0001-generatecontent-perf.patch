+// Returns whether the `type` resource dictionary in `resources` maps `name` to
+// a reference to `resource`. If so, `name` can keep being used for `resource`.
+bool IsResourceNameMappedTo(const CPDF_Dictionary* resources,
+                            ByteStringView type,
+                            const ByteString& name,
+                            const CPDF_Object* resource) {
+  const uint32_t resource_obj_num = resource->GetObjNum();
+  if (!resources || name.IsEmpty() || resource_obj_num == 0) {
+    return false;
+  }
+
+  RetainPtr<const CPDF_Dictionary> resource_dict = resources->GetDictFor(type);
+  if (!resource_dict) {
+    return false;
+  }
+
+  RetainPtr<const CPDF_Reference> ref =
+      ToReference(resource_dict->GetObjectFor(name.AsStringView()));
+  return ref && ref->GetRefObjNum() == resource_obj_num;
+}
