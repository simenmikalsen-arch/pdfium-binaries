+RetainPtr<CPDF_Stream> AddStream(CPDF_Document* doc,
+                                 ByteStringView contents,
+                                 RetainPtr<CPDF_Dictionary> dict) {
+  pdfium::span<const uint8_t> data = contents.unsigned_span();
+  return doc->NewIndirect<CPDF_Stream>(
+      DataVector<uint8_t>(data.begin(), data.end()), std::move(dict));
+}
+
+RetainPtr<CPDF_Stream> AddFormXObject(CPDF_Document* doc) {
+  auto dict = pdfium::MakeRetain<CPDF_Dictionary>();
+  dict->SetNewFor<CPDF_Name>("Type", "XObject");
+  dict->SetNewFor<CPDF_Name>("Subtype", "Form");
+  dict->SetRectFor("BBox", CFX_FloatRect(0, 0, 10, 10));
+  return AddStream(doc, "0 0 10 10 re f", std::move(dict));
+}
+
+ByteString GetStreamData(RetainPtr<const CPDF_Stream> stream) {
+  auto stream_acc = pdfium::MakeRetain<CPDF_StreamAcc>(std::move(stream));
+  stream_acc->LoadAllDataFiltered();
+  return ByteString(ByteStringView(stream_acc->GetSpan()));
+}
