+std::vector<float> CPDF_Color::GetNonPatternValues() const {
+  if (!cs_ || IsPatternInternal() ||
+      !std::holds_alternative<std::vector<float>>(color_data_)) {
+    return {};
+  }
+  return std::get<std::vector<float>>(color_data_);
