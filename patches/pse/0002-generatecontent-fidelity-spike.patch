+TEST_F(CPDFPageContentGeneratorTest, ProcessCMYKPathWithMiterLimit) {
+  auto path_obj = std::make_unique<CPDF_PathObject>();
+  path_obj->set_filltype(CFX_FillRenderOptions::FillType::kWinding);
+  path_obj->path().AppendRect(0, 0, 10, 10);
+  RetainPtr<CPDF_ColorSpace> cmyk =
+      CPDF_ColorSpace::GetStockCS(CPDF_ColorSpace::Family::kDeviceCMYK);
+  path_obj->mutable_color_state().SetFillColor(
+      cmyk, std::vector<float>{0.1f, 0.9f, 0.8f, 0});
+  path_obj->mutable_color_state().SetStrokeColor(
+      cmyk, std::vector<float>{0, 0, 0, 1});
+  path_obj->mutable_graph_state().SetMiterLimit(2);
+
+  auto dummy_page_dict = pdfium::MakeRetain<CPDF_Dictionary>();
+  auto test_page = pdfium::MakeRetain<CPDF_Page>(nullptr, dummy_page_dict);
+  CPDF_PageContentGenerator generator(test_page.Get());
+  fxcrt::ostringstream buf;
+  TestProcessPath(&generator, &buf, path_obj.get());
+  EXPECT_EQ("q .1 .9 .8 0 k 0 0 0 1 K 2 M 0 0 10 10 re f Q\n",
+            ByteString(buf));
+}
+
+TEST_F(CPDFPageContentGeneratorTest, ProcessTextWithCharAndWordSpacing) {
+  auto doc = std::make_unique<CPDF_TestDocument>();
+  doc->CreateNewDoc();
+  RetainPtr<CPDF_Dictionary> page_dict(doc->CreateNewPage(0));
+  auto page = pdfium::MakeRetain<CPDF_Page>(doc.get(), page_dict);
+  CPDF_PageContentGenerator generator(page.Get());
+  auto text_obj = std::make_unique<CPDF_TextObject>();
+  text_obj->mutable_text_state().SetFont(
+      CPDF_Font::GetStockFont(doc.get(), "Helvetica"));
+  text_obj->mutable_text_state().SetFontSize(12.0f);
+  text_obj->mutable_text_state().SetCharSpace(2.5f);
+  text_obj->mutable_text_state().SetWordSpace(6.0f);
+  text_obj->SetText("A B");
+  fxcrt::ostringstream buf;
+  TestProcessText(&generator, &buf, text_obj.get());
+  EXPECT_TRUE(ByteString(buf).Contains(" 12 Tf 0 Tr 2.5 Tc 6 Tw [<412042>] TJ ET"));
+}
