+void CPDF_PageContentGenerator::ProcessShading(
+    fxcrt::ostringstream* buf,
+    CPDF_ShadingObject* pShadingObj) {
+  const CPDF_ShadingPattern* pattern = pShadingObj->pattern();
+  if (!pattern) {
+    return;
+  }
+
+  ByteString name =
+      FindOrRealizeResource(pattern->GetShadingObject(), "Shading");
+  if (name.IsEmpty()) {
+    return;
+  }
+
+  // The clip path written by ProcessGraphics() bounds the painted area.
+  ProcessGraphics(buf, pShadingObj);
+  const CFX_Matrix& matrix = pShadingObj->matrix();
+  if (!matrix.IsIdentity()) {
+    WriteMatrix(*buf, matrix) << " cm ";
+  }
+  *buf << "/" << PDF_NameEncode(name) << " sh";
+  EndProcessGraphics(*buf);
+}
+
+bool CPDF_PageContentGenerator::WriteColor(fxcrt::ostringstream& buf,
+                                           const CPDF_Color* color,
+                                           bool stroke) {
+  if (!color || color->IsNull()) {
+    return false;
+  }
+
+  if (color->IsPattern()) {
+    RetainPtr<CPDF_Pattern> pattern = color->GetPattern();
+    if (!pattern) {
+      return false;
+    }
+    // An uncolored tiling pattern also needs its underlying color space and
+    // components, which are not kept.
+    CPDF_TilingPattern* tiling = pattern->AsTilingPattern();
+    if (tiling && !tiling->colored()) {
+      return false;
+    }
+    ByteString name =
+        FindOrRealizeResource(pattern->GetPatternObject(), "Pattern");
+    if (name.IsEmpty()) {
+      return false;
+    }
+    buf << (stroke ? "/Pattern CS /" : "/Pattern cs /")
+        << PDF_NameEncode(name) << (stroke ? " SCN " : " scn ");
+    return true;
+  }
+
+  if (color->IsColorSpaceCMYK()) {
+    std::vector<float> values = color->GetNonPatternValues();
+    if (values.size() < 4) {
+      return false;
+    }
+    for (size_t i = 0; i < 4; ++i) {
+      WriteFloat(buf, values[i]) << " ";
+    }
+    buf << (stroke ? "K " : "k ");
+    return true;
+  }
+
+  if (!WriteColorToStream(buf, color)) {
+    return false;
+  }
+  buf << (stroke ? " RG " : " rg ");
+  return true;
+}
+
+bool CPDF_PageContentGenerator::ProcessOriginalGraphicsStates(
+    fxcrt::ostringstream& buf,
+    CPDF_PageObject* pPageObj) {
+  pdfium::span<const ByteString> names = pPageObj->GetGraphicsResourceNames();
+  if (names.empty()) {
+    return false;
+  }
+
+  RetainPtr<const CPDF_Dictionary> resources = obj_holder_->GetResources();
+  RetainPtr<const CPDF_Dictionary> states =
+      resources ? resources->GetDictFor("ExtGState") : nullptr;
+  if (!states) {
+    return false;
+  }
+
+  // A soft mask is positioned by the CTM in effect when its ExtGState was
+  // set; the regenerated stream starts from the identity matrix.
+  const CFX_Matrix* smask_matrix = pPageObj->general_state().GetSMaskMatrix();
+  const bool move_smask = pPageObj->general_state().GetSoftMask() &&
+                          smask_matrix && !smask_matrix->IsIdentity();
+  bool wrote = false;
+  for (const ByteString& name : names) {
+    if (!states->GetDictFor(name.AsStringView())) {
+      continue;
+    }
+    if (!wrote && move_smask) {
+      WriteMatrix(buf, *smask_matrix) << " cm ";
+    }
+    buf << "/" << PDF_NameEncode(name) << " gs ";
+    wrote = true;
+  }
+  if (wrote && move_smask) {
+    WriteMatrix(buf, smask_matrix->GetInverse()) << " cm ";
+  }
+  return wrote;
+}
+
+ByteString CPDF_PageContentGenerator::FindOrRealizeResource(
+    RetainPtr<const CPDF_Object> resource,
+    ByteStringView type) {
+  if (!resource) {
+    return ByteString();
+  }
+
+  if (resource->IsInline()) {
+    // A direct object in the resources: give a copy an object number.
+    RetainPtr<CPDF_Object> clone = resource->Clone();
+    document_->AddIndirectObject(clone);
+    resource = clone;
+  }
+
+  const uint32_t obj_num = resource->GetObjNum();
+  RetainPtr<const CPDF_Dictionary> resources = obj_holder_->GetResources();
+  RetainPtr<const CPDF_Dictionary> dict =
+      resources ? resources->GetDictFor(type) : nullptr;
+  if (dict) {
+    CPDF_DictionaryLocker locker(dict);
+    for (const auto& it : locker) {
+      RetainPtr<const CPDF_Reference> ref = ToReference(it.second);
+      if (ref && ref->GetRefObjNum() == obj_num) {
+        return it.first;
+      }
+    }
+  }
+  return RealizeResource(resource.Get(), type);
+}
