+
+// PDFium draws a text markup annotation whose appearance it generated into the
+// bounds of its quad points (CPDF_Annot::RectForDrawing()), and any appearance
+// of its own into /Rect. For an appearance generated from the quad points that
+// becomes the annotation's own, /Rect is set to the appearance's bounding box,
+// so it is drawn the same, here and in other viewers.
+void MatchRectToTextMarkupAppearance(CPDF_Dictionary* annot_dict) {
+  const CPDF_Annot::Subtype subtype = CPDF_Annot::StringToAnnotSubtype(
+      annot_dict->GetNameFor(pdfium::annotation::kSubtype));
+  if (subtype != CPDF_Annot::Subtype::HIGHLIGHT &&
+      subtype != CPDF_Annot::Subtype::SQUIGGLY &&
+      subtype != CPDF_Annot::Subtype::STRIKEOUT &&
+      subtype != CPDF_Annot::Subtype::UNDERLINE) {
+    return;
+  }
+  if (!GetQuadPointsArrayFromDictionary(annot_dict)) {
+    return;
+  }
+  annot_dict->SetRectFor(pdfium::annotation::kRect,
+                         CPDF_Annot::BoundingRectFromQuadPoints(annot_dict));
