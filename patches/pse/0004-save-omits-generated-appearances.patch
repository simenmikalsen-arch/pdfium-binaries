+namespace {
+
+bool SavedContains(const std::string& saved, const char* text) {
+  return saved.find(text) != std::string::npos;
+}
+
+bool HasGeneratedAPMark(FPDF_ANNOTATION annot) {
+  return FPDFAnnot_HasKey(annot, pdfium::annotation::kPDFiumHasGeneratedAP);
+}
+
+}  // namespace
+
+TEST_F(FPDFAnnotEmbedderTest, SaveOmitsGeneratedAppearances) {
+  // Four text markup annotations without an appearance stream.
+  ASSERT_TRUE(OpenDocument("annotation_markup_multiline_no_ap.pdf"));
+  ScopedPage page = LoadScopedPage(0);
+  ASSERT_TRUE(page);
+
+  ASSERT_TRUE(FPDF_SaveAsCopy(document(), this, 0));
+  const std::string saved_before_render = GetString();
+  ClearString();
+  EXPECT_FALSE(SavedContains(saved_before_render, "/AP"));
+
+  // Drawing the annotations generates an appearance for each of them.
+  RenderLoadedPageWithFlags(page.get(), FPDF_ANNOT);
+  ASSERT_EQ(4, FPDFPage_GetAnnotCount(page.get()));
+  for (int i = 0; i < 4; ++i) {
+    ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(page.get(), i));
+    ASSERT_TRUE(annot);
+    EXPECT_TRUE(FPDFAnnot_HasKey(annot.get(), pdfium::annotation::kAP));
+    EXPECT_TRUE(HasGeneratedAPMark(annot.get()));
+  }
+
+  // A save writes neither the generated appearances (nor the objects only they
+  // refer to) nor their mark, so it does not depend on what was drawn.
+  ASSERT_TRUE(FPDF_SaveAsCopy(document(), this, 0));
+  const std::string saved_after_render = GetString();
+  EXPECT_FALSE(SavedContains(saved_after_render, "/AP"));
+  EXPECT_FALSE(SavedContains(saved_after_render, "/XObject"));
+  EXPECT_FALSE(SavedContains(saved_after_render,
+                             pdfium::annotation::kPDFiumHasGeneratedAP));
+  // Only the trailer's /Size may differ (the skipped new object numbers).
+  EXPECT_LE(saved_after_render.size(), saved_before_render.size() + 4);
+  EXPECT_GE(saved_after_render.size(), saved_before_render.size());
+
+  // The in-memory appearances are untouched.
+  {
+    ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(page.get(), 0));
+    ASSERT_TRUE(annot);
+    EXPECT_TRUE(FPDFAnnot_HasKey(annot.get(), pdfium::annotation::kAP));
+    EXPECT_TRUE(HasGeneratedAPMark(annot.get()));
+  }
+
+  // The saved document draws the same: PDFium generates the appearances again.
+  ScopedSavedDoc saved_doc = OpenScopedSavedDocument();
+  ASSERT_TRUE(saved_doc);
+  ScopedSavedPage saved_page = LoadScopedSavedPage(0);
+  ASSERT_TRUE(saved_page);
+  VerifySavedRenderingWithExpectationSuffix(
+      saved_page.get(), "annotation_markup_multiline_no_ap");
+}
+
+TEST_F(FPDFAnnotEmbedderTest, GenerateAPIsSaved) {
+  EXPECT_FALSE(FPDFAnnot_GenerateAP(nullptr));
+
+  ASSERT_TRUE(OpenDocument("annotation_markup_multiline_no_ap.pdf"));
+  ScopedPage page = LoadScopedPage(0);
+  ASSERT_TRUE(page);
+
+  {
+    ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(page.get(), 0));
+    ASSERT_TRUE(annot);
+    ASSERT_TRUE(FPDFAnnot_GenerateAP(annot.get()));
+    EXPECT_TRUE(FPDFAnnot_HasKey(annot.get(), pdfium::annotation::kAP));
+    EXPECT_FALSE(HasGeneratedAPMark(annot.get()));
+  }
+
+  // Drawing keeps that appearance and generates the other three.
+  RenderLoadedPageWithFlags(page.get(), FPDF_ANNOT);
+  for (int i = 0; i < 4; ++i) {
+    ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(page.get(), i));
+    ASSERT_TRUE(annot);
+    EXPECT_TRUE(FPDFAnnot_HasKey(annot.get(), pdfium::annotation::kAP));
+    EXPECT_EQ(i != 0, HasGeneratedAPMark(annot.get()));
+  }
+
+  ASSERT_TRUE(FPDF_SaveAsCopy(document(), this, 0));
+  EXPECT_FALSE(
+      SavedContains(GetString(), pdfium::annotation::kPDFiumHasGeneratedAP));
+
+  // Only the first annotation has an appearance in the saved document.
+  ScopedSavedDoc saved_doc = OpenScopedSavedDocument();
+  ASSERT_TRUE(saved_doc);
+  ScopedSavedPage saved_page = LoadScopedSavedPage(0);
+  ASSERT_TRUE(saved_page);
+  ASSERT_EQ(4, FPDFPage_GetAnnotCount(saved_page.get()));
+  for (int i = 0; i < 4; ++i) {
+    ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(saved_page.get(), i));
+    ASSERT_TRUE(annot);
+    EXPECT_EQ(i == 0, FPDFAnnot_HasKey(annot.get(), pdfium::annotation::kAP));
+    EXPECT_FALSE(HasGeneratedAPMark(annot.get()));
+  }
+  VerifySavedRenderingWithExpectationSuffix(
+      saved_page.get(), "annotation_markup_multiline_no_ap");
+}
