+bool HasGeneratedAPMark(FPDF_ANNOTATION annot) {
+  return FPDFAnnot_HasKey(annot, pdfium::annotation::kPDFiumHasGeneratedAP);
+}
+
+// A saved document loaded without a form-fill environment, whose page view
+// would generate appearances for the annotations that have none. `saved` must
+// outlive the document.
+ScopedFPDFDocument LoadWithoutFormFill(const std::string& saved) {
+  return ScopedFPDFDocument(FPDF_LoadMemDocument(
+      saved.data(), static_cast<int>(saved.size()), nullptr));
