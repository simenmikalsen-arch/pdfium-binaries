+TEST_F(FPDFAnnotEmbedderTest, MarkGeneratedAPAndSetAP) {
+  EXPECT_FALSE(FPDFAnnot_MarkGeneratedAP(nullptr, true));
+  EXPECT_FALSE(FPDFAnnot_MarkGeneratedAP(nullptr, false));
+
+  ASSERT_TRUE(OpenDocument("annotation_markup_multiline_no_ap.pdf"));
+  ScopedPage page = LoadScopedPage(0);
+  ASSERT_TRUE(page);
+  RenderLoadedPageWithFlags(page.get(), FPDF_ANNOT);
+
+  {
+    // A generated appearance adopted as the annotation's own.
+    ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(page.get(), 0));
+    ASSERT_TRUE(annot);
+    ASSERT_TRUE(HasGeneratedAPMark(annot.get()));
+    ASSERT_TRUE(FPDFAnnot_MarkGeneratedAP(annot.get(), false));
+    EXPECT_FALSE(HasGeneratedAPMark(annot.get()));
+    EXPECT_TRUE(FPDFAnnot_HasKey(annot.get(), pdfium::annotation::kAP));
+  }
+  {
+    // An appearance set by the caller replaces the generated one.
+    ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(page.get(), 1));
+    ASSERT_TRUE(annot);
+    ASSERT_TRUE(HasGeneratedAPMark(annot.get()));
+    ScopedFPDFWideString ap =
+        GetFPDFWideString(L"0 0 1 rg 108 552 398 38 re f");
+    ASSERT_TRUE(FPDFAnnot_SetAP(annot.get(), FPDF_ANNOT_APPEARANCEMODE_NORMAL,
+                                ap.get()));
+    EXPECT_FALSE(HasGeneratedAPMark(annot.get()));
+  }
+  {
+    // An appearance marked as generated after all.
+    ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(page.get(), 3));
+    ASSERT_TRUE(annot);
+    ASSERT_TRUE(FPDFAnnot_MarkGeneratedAP(annot.get(), false));
+    ASSERT_TRUE(FPDFAnnot_MarkGeneratedAP(annot.get(), true));
+    EXPECT_TRUE(HasGeneratedAPMark(annot.get()));
+  }
+  // Annotation 2 keeps its generated appearance.
+
+  ASSERT_TRUE(FPDF_SaveAsCopy(document(), this, 0));
+  EXPECT_FALSE(
+      SavedContains(GetString(), pdfium::annotation::kPDFiumHasGeneratedAP));
+
+  ScopedSavedDoc saved_doc = OpenScopedSavedDocument();
+  ASSERT_TRUE(saved_doc);
+  ScopedSavedPage saved_page = LoadScopedSavedPage(0);
+  ASSERT_TRUE(saved_page);
+  ASSERT_EQ(4, FPDFPage_GetAnnotCount(saved_page.get()));
+  for (int i = 0; i < 4; ++i) {
+    ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(saved_page.get(), i));
+    ASSERT_TRUE(annot);
+    EXPECT_EQ(i <= 1, FPDFAnnot_HasKey(annot.get(), pdfium::annotation::kAP));
+  }
+}
