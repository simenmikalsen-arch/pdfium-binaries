+TEST_F(FPDFAnnotEmbedderTest, SaveOmitsGeneratedAppearanceOfNewAnnotation) {
+  ASSERT_TRUE(OpenDocument("hello_world.pdf"));
+  ScopedPage page = LoadScopedPage(0);
+  ASSERT_TRUE(page);
+
+  {
+    // A new annotation's dictionary is direct in /Annots.
+    ScopedFPDFAnnotation annot(
+        FPDFPage_CreateAnnot(page.get(), FPDF_ANNOT_SQUARE));
+    ASSERT_TRUE(annot);
+    const FS_RECTF rect = {20.0f, 40.0f, 90.0f, 70.0f};
+    ASSERT_TRUE(FPDFAnnot_SetRect(annot.get(), &rect));
+    ASSERT_TRUE(FPDFAnnot_SetColor(annot.get(), FPDFANNOT_COLORTYPE_Color, 0,
+                                   0, 255, 255));
+    ScopedFPDFWideString ap = GetFPDFWideString(L"0 0 1 RG 21 41 68 28 re S");
+    ASSERT_TRUE(FPDFAnnot_SetAP(annot.get(), FPDF_ANNOT_APPEARANCEMODE_NORMAL,
+                                ap.get()));
+    ASSERT_TRUE(FPDFAnnot_MarkGeneratedAP(annot.get(), true));
+  }
+  ASSERT_TRUE(FPDF_SaveAsCopy(document(), this, 0));
+  EXPECT_FALSE(SavedContains(GetString(), "/AP"));
+  EXPECT_FALSE(
+      SavedContains(GetString(), pdfium::annotation::kPDFiumHasGeneratedAP));
+  EXPECT_TRUE(SavedContains(GetString(), "/Square"));
+  ClearString();
+
+  {
+    ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(page.get(), 0));
+    ASSERT_TRUE(annot);
+    ASSERT_TRUE(FPDFAnnot_GenerateAP(annot.get()));
+  }
+  ASSERT_TRUE(FPDF_SaveAsCopy(document(), this, 0));
+  EXPECT_TRUE(SavedContains(GetString(), "/AP"));
+  EXPECT_FALSE(
+      SavedContains(GetString(), pdfium::annotation::kPDFiumHasGeneratedAP));
