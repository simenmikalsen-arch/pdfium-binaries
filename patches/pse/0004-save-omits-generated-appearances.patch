+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_GenerateAP(FPDF_ANNOTATION annot) {
+  CPDF_AnnotContext* context = CPDFAnnotContextFromFPDFAnnotation(annot);
+  if (!context) {
+    return false;
+  }
+
+  CPDF_Document* doc = context->GetPage()->GetDocument();
+  if (!doc) {
+    return false;
+  }
+
+  RetainPtr<CPDF_Dictionary> annot_dict = context->GetMutableAnnotDict();
+  const CPDF_Annot::Subtype subtype = CPDF_Annot::StringToAnnotSubtype(
+      annot_dict->GetNameFor(pdfium::annotation::kSubtype));
+  if (!CPDF_GenerateAP::GenerateAnnotAP(doc, annot_dict.Get(), subtype)) {
+    return false;
+  }
+
+  // Unlike an appearance generated to draw the annotation, this one is the
+  // annotation's own: it is written when the document is saved.
+  annot_dict->RemoveFor(pdfium::annotation::kPDFiumHasGeneratedAP);
+  if (context->HasForm()) {
+    context->SetForm(
+        GetAnnotAP(annot_dict.Get(), CPDF_Annot::AppearanceMode::kNormal));
+  }
+  return true;
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFAnnot_MarkGeneratedAP(FPDF_ANNOTATION annot, FPDF_BOOL generated) {
+  RetainPtr<CPDF_Dictionary> annot_dict =
+      GetMutableAnnotDictFromFPDFAnnotation(annot);
+  if (!annot_dict) {
+    return false;
+  }
+
+  if (generated) {
+    annot_dict->SetNewFor<CPDF_Boolean>(
+        pdfium::annotation::kPDFiumHasGeneratedAP, true);
+  } else {
+    annot_dict->RemoveFor(pdfium::annotation::kPDFiumHasGeneratedAP);
+  }
+  return true;
+}
