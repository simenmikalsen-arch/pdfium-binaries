+TEST_F(FPDFAnnotEmbedderTest, SaveKeepsRectOfGeneratedInkAppearance) {
+  // Two ink annotations without an appearance stream, /Rect [293 530 349 542].
+  // Generating an ink appearance inflates /Rect by half the border width (1).
+  ASSERT_TRUE(OpenDocument("ink_annot.pdf"));
+  ScopedPage page = LoadScopedPage(0);
+  ASSERT_TRUE(page);
+  RenderLoadedPageWithFlags(page.get(), FPDF_ANNOT);
+  FS_RECTF rect;
+  for (int i = 0; i < 2; ++i) {
+    ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(page.get(), i));
+    ASSERT_TRUE(annot);
+    EXPECT_TRUE(HasGeneratedAPMark(annot.get()));
+    ASSERT_TRUE(FPDFAnnot_GetRect(annot.get(), &rect));
+    EXPECT_FLOAT_EQ(292.5f, rect.left);
+    EXPECT_FLOAT_EQ(542.5f, rect.top);
+  }
+
+  // The save writes the annotations as they were.
+  ASSERT_TRUE(FPDF_SaveAsCopy(document(), this, 0));
+  {
+    const std::string saved = GetString();
+    EXPECT_FALSE(
+        SavedContains(saved, pdfium::annotation::kPDFiumRectBeforeGeneratedAP));
+    ScopedFPDFDocument saved_doc = LoadWithoutFormFill(saved);
+    ASSERT_TRUE(saved_doc);
+    ScopedFPDFPage saved_page(FPDF_LoadPage(saved_doc.get(), 0));
+    ASSERT_TRUE(saved_page);
+    for (int i = 0; i < 2; ++i) {
+      ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(saved_page.get(), i));
+      ASSERT_TRUE(annot);
+      EXPECT_FALSE(FPDFAnnot_HasKey(annot.get(), pdfium::annotation::kAP));
+      ASSERT_TRUE(FPDFAnnot_GetRect(annot.get(), &rect));
+      EXPECT_FLOAT_EQ(293.0f, rect.left);
+      EXPECT_FLOAT_EQ(530.0f, rect.bottom);
+      EXPECT_FLOAT_EQ(349.0f, rect.right);
+      EXPECT_FLOAT_EQ(542.0f, rect.top);
+    }
+  }
+  ClearString();
+
+  {
+    // Removing the generated appearance restores /Rect, so the next one is
+    // generated from the same dictionary (inflated once, not twice).
+    ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(page.get(), 0));
+    ASSERT_TRUE(annot);
+    ASSERT_TRUE(FPDFAnnot_SetAP(annot.get(), FPDF_ANNOT_APPEARANCEMODE_NORMAL,
+                                nullptr));
+    EXPECT_FALSE(HasGeneratedAPMark(annot.get()));
+    ASSERT_TRUE(FPDFAnnot_GetRect(annot.get(), &rect));
+    EXPECT_FLOAT_EQ(293.0f, rect.left);
+  }
+  {
+    // A /Rect set by the caller is saved as it is.
+    ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(page.get(), 1));
+    ASSERT_TRUE(annot);
+    // FS_RECTF: left, top, right, bottom.
+    const FS_RECTF new_rect = {300.0f, 560.0f, 360.0f, 500.0f};
+    ASSERT_TRUE(FPDFAnnot_SetRect(annot.get(), &new_rect));
+  }
+  RenderLoadedPageWithFlags(page.get(), FPDF_ANNOT);
+  {
+    ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(page.get(), 0));
+    ASSERT_TRUE(annot);
+    EXPECT_TRUE(HasGeneratedAPMark(annot.get()));
+    ASSERT_TRUE(FPDFAnnot_GetRect(annot.get(), &rect));
+    EXPECT_FLOAT_EQ(292.5f, rect.left);
+  }
+
+  ASSERT_TRUE(FPDF_SaveAsCopy(document(), this, 0));
+  const std::string saved = GetString();
+  ScopedFPDFDocument saved_doc = LoadWithoutFormFill(saved);
+  ASSERT_TRUE(saved_doc);
+  ScopedFPDFPage saved_page(FPDF_LoadPage(saved_doc.get(), 0));
+  ASSERT_TRUE(saved_page);
+  {
+    ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(saved_page.get(), 0));
+    ASSERT_TRUE(annot);
+    ASSERT_TRUE(FPDFAnnot_GetRect(annot.get(), &rect));
+    EXPECT_FLOAT_EQ(293.0f, rect.left);
+    EXPECT_FLOAT_EQ(542.0f, rect.top);
+  }
+  {
+    ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(saved_page.get(), 1));
+    ASSERT_TRUE(annot);
+    ASSERT_TRUE(FPDFAnnot_GetRect(annot.get(), &rect));
+    EXPECT_FLOAT_EQ(300.0f, rect.left);
+    EXPECT_FLOAT_EQ(560.0f, rect.top);
+  }
+}
