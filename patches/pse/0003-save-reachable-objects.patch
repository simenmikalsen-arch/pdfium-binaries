+TEST_F(FPDFSaveEmbedderTest, SaveNewDocSkipsUnreferencedNewObjects) {
+  // A document without a parser (FPDF_CreateNewDocument()): every object is
+  // new, and a full save writes the ones reachable from /Root and /Info.
+  ScopedFPDFDocument new_doc(FPDF_CreateNewDocument());
+  ASSERT_TRUE(new_doc);
+  {
+    ScopedFPDFPage page(FPDFPage_New(new_doc.get(), 0, 612, 792));
+    ASSERT_TRUE(page);
+  }
+  ASSERT_TRUE(FPDF_SaveAsCopy(new_doc.get(), this, FPDF_NO_INCREMENTAL));
+  const int plain_objects = CountWrittenObjects(GetString());
+  ClearString();
+
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(new_doc.get());
+  auto orphan = doc->NewIndirect<CPDF_Dictionary>();
+  orphan->SetNewFor<CPDF_Name>("Type", "PSEOrphan");
+  // An indirect object that only /Info refers to is written.
+  auto producer = doc->NewIndirect<CPDF_String>("PSEProducer");
+  doc->GetInfo()->SetNewFor<CPDF_Reference>("Producer", doc,
+                                            producer->GetObjNum());
+
+  ASSERT_TRUE(FPDF_SaveAsCopy(new_doc.get(), this, FPDF_NO_INCREMENTAL));
+  EXPECT_THAT(GetString(), Not(HasSubstr("PSEOrphan")));
+  EXPECT_THAT(GetString(), HasSubstr("(PSEProducer)"));
+  EXPECT_EQ(plain_objects + 1, CountWrittenObjects(GetString()));
+
+  ScopedSavedDoc saved = OpenScopedSavedDocument();
+  ASSERT_TRUE(saved);
+  EXPECT_EQ(1, FPDF_GetPageCount(saved.get()));
+  unsigned short buffer[32];
+  ASSERT_EQ(24u,
+            FPDF_GetMetaText(saved.get(), "Producer", buffer, sizeof(buffer)));
+  EXPECT_EQ(L"PSEProducer", GetPlatformWString(buffer));
+}
