+TEST_F(FPDFSaveEmbedderTest, SaveSkipsUnreferencedNewObjects) {
+  ASSERT_TRUE(OpenDocument("hello_world.pdf"));
+  ASSERT_TRUE(FPDF_SaveAsCopy(document(), this, FPDF_NO_INCREMENTAL));
+  const size_t plain_size = GetString().size();
+  ClearString();
+
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document());
+  auto orphan = doc->NewIndirect<CPDF_Dictionary>();
+  orphan->SetNewFor<CPDF_Name>("Type", "PSEOrphan");
+  auto kept = doc->NewIndirect<CPDF_Dictionary>();
+  kept->SetNewFor<CPDF_Name>("Type", "PSEKept");
+
+  // Neither is referenced: a full save writes neither.
+  ASSERT_TRUE(FPDF_SaveAsCopy(document(), this, FPDF_NO_INCREMENTAL));
+  EXPECT_EQ(plain_size, GetString().size());
+  EXPECT_THAT(GetString(), Not(HasSubstr("PSEOrphan")));
+  EXPECT_THAT(GetString(), Not(HasSubstr("PSEKept")));
+  ClearString();
+
+  // Once the catalog refers to one of them, that one is written.
+  doc->GetMutableRoot()->SetNewFor<CPDF_Reference>("PSEKept", doc,
+                                                   kept->GetObjNum());
+  ASSERT_TRUE(FPDF_SaveAsCopy(document(), this, FPDF_NO_INCREMENTAL));
+  EXPECT_THAT(GetString(), HasSubstr("/Type/PSEKept"));
+  EXPECT_THAT(GetString(), Not(HasSubstr("PSEOrphan")));
+  ClearString();
+
+  // An incremental save still writes every new object.
+  ASSERT_TRUE(FPDF_SaveAsCopy(document(), this, FPDF_INCREMENTAL));
+  EXPECT_THAT(GetString(), HasSubstr("PSEOrphan"));
+}
