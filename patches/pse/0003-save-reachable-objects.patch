+// Adds `object` (if it is indirect) and every indirect object reachable from it
+// to `objects`. Objects already in `objects` are not traversed again.
+void AddReachableObjects(const CPDF_Document* document,
+                         RetainPtr<const CPDF_Object> object,
+                         std::set<uint32_t>* objects) {
+  std::vector<RetainPtr<const CPDF_Object>> pending;
+  const uint32_t object_number = object->GetObjNum();
+  if (object_number != 0 && !objects->insert(object_number).second) {
+    return;
+  }
+  pending.push_back(std::move(object));
+  while (!pending.empty()) {
+    RetainPtr<const CPDF_Object> current = std::move(pending.back());
+    pending.pop_back();
+    switch (current->GetType()) {
+      case CPDF_Object::kArray: {
+        CPDF_ArrayLocker locker(current->AsArray());
+        for (const auto& it : locker) {
+          pending.push_back(it);
+        }
+        break;
+      }
+      case CPDF_Object::kDictionary: {
+        CPDF_DictionaryLocker locker(current->AsDictionary());
+        for (const auto& it : locker) {
+          pending.push_back(it.second);
+        }
+        break;
+      }
+      case CPDF_Object::kStream: {
+        CPDF_DictionaryLocker locker(current->AsStream()->GetDict());
+        for (const auto& it : locker) {
+          pending.push_back(it.second);
+        }
+        break;
+      }
+      case CPDF_Object::kReference: {
+        const uint32_t ref_object_number =
+            current->AsReference()->GetRefObjNum();
+        if (!objects->insert(ref_object_number).second) {
+          break;
+        }
+        RetainPtr<const CPDF_Object> target =
+            document->GetIndirectObject(ref_object_number);
+        if (target) {
+          pending.push_back(std::move(target));
+        }
+        break;
+      }
+      default:
+        break;
+    }
+  }
+}
+
