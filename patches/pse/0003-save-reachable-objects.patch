+namespace {
+
+// Number of indirect objects in a document written by CPDF_Creator.
+int CountWrittenObjects(const std::string& pdf) {
+  int count = 0;
+  for (size_t pos = pdf.find(" 0 obj\r\n"); pos != std::string::npos;
+       pos = pdf.find(" 0 obj\r\n", pos + 1)) {
+    ++count;
+  }
+  return count;
+}
