+TEST_F(FPDFSaveEmbedderTest, SaveImportedPagesSkipsReplacedAppearances) {
+  // Pages imported into a new document (split / combine), rendered with
+  // FPDF_ANNOT: dropping a generated appearance and rendering again replaces
+  // it, and a full save does not write the replaced streams.
+  ASSERT_TRUE(OpenDocument("annotation_highlight_long_content.pdf"));
+  ScopedFPDFDocument new_doc(FPDF_CreateNewDocument());
+  ASSERT_TRUE(new_doc);
+  ASSERT_TRUE(FPDF_ImportPages(new_doc.get(), document(), "1", 0));
+  ScopedFPDFPage page(FPDF_LoadPage(new_doc.get(), 0));
+  ASSERT_TRUE(page);
+
+  auto drop_appearance_and_render = [&page]() {
+    {
+      ScopedFPDFAnnotation annot(FPDFPage_GetAnnot(page.get(), 0));
+      ASSERT_TRUE(annot);
+      ASSERT_TRUE(FPDFAnnot_SetAP(annot.get(), FPDF_ANNOT_APPEARANCEMODE_NORMAL,
+                                  nullptr));
+    }
+    ScopedFPDFBitmap bitmap =
+        RenderPageWithFlags(page.get(), nullptr, FPDF_ANNOT);
+    ASSERT_TRUE(bitmap);
+  };
+
+  // The highlight now has an appearance PDFium generated.
+  drop_appearance_and_render();
+  ASSERT_TRUE(FPDF_SaveAsCopy(new_doc.get(), this, FPDF_NO_INCREMENTAL));
+  const int objects = CountWrittenObjects(GetString());
+  ClearString();
+
+  for (int i = 0; i < 3; ++i) {
+    drop_appearance_and_render();
+  }
+  ASSERT_TRUE(FPDF_SaveAsCopy(new_doc.get(), this, FPDF_NO_INCREMENTAL));
+  EXPECT_EQ(objects, CountWrittenObjects(GetString()));
+
+  ScopedSavedDoc saved = OpenScopedSavedDocument();
+  ASSERT_TRUE(saved);
+  ScopedSavedPage saved_page = LoadScopedSavedPage(0);
+  ASSERT_TRUE(saved_page);
+  EXPECT_EQ(1, FPDFPage_GetAnnotCount(saved_page.get()));
+}
